      <stop offset="0%" stop-color="#4a8f3b"/>
      <stop offset="70%" stop-color="#2d6423"/>
      <stop offset="100%" stop-color="#163c12"/>
    </radialGradient>
    <radialGradient id="powderyMildew" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95"/>
      <stop offset="40%" stop-color="#e2e8f0" stop-opacity="0.8"/>
      <stop offset="75%" stop-color="#cbd5e1" stop-opacity="0.4"/>
      <stop offset="100%" stop-color="#4a8f3b" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="600" height="450" fill="#1b241c"/>
  <g transform="translate(150, 30)">
    <path d="M150,40 Q210,30 250,90 Q290,140 260,210 Q280,270 240,320 Q190,360 150,380 Q110,360 60,320 Q20,270 40,210 Q10,140 50,90 Q90,30 150,40 Z" fill="url(#grapeLeaf)" stroke="#1a4217" stroke-width="3"/>
    <path d="M150,375 L150,55" stroke="#7cbd6c" stroke-width="3"/>
    <path d="M150,375 L245,100" stroke="#7cbd6c" stroke-width="2.5"/>
