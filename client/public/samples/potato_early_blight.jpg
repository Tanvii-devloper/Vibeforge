    </radialGradient>
  </defs>
  <rect width="600" height="450" fill="#1b241c"/>
  <g transform="translate(150, 40)">
    <path d="M150,30 C230,70 270,170 250,270 C230,350 180,380 150,390 C120,380 70,350 50,270 C30,170 70,70 150,30 Z" fill="url(#potatoLeaf)" stroke="#1a4217" stroke-width="3"/>
