<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 450" width="100%" height="100%">
  <defs>
    <radialGradient id="leafGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#3d7e35"/>
      <stop offset="70%" stop-color="#245821"/>
      <stop offset="100%" stop-color="#143912"/>
    </radialGradient>
    <radialGradient id="blightLesion" cx="45%" cy="45%" r="50%">
      <stop offset="0%" stop-color="#3e2e1e"/>
      <stop offset="60%" stop-color="#55442e"/>
      <stop offset="85%" stop-color="#7a7037"/>
      <stop offset="100%" stop-color="#3d7e35" stop-opacity="0"/>
    </radialGradient>
    <filter id="shadow">
      <feDropShadow dx="2" dy="4" stdDeviation="6" flood-opacity="0.3"/>
    </filter>
  </defs>
  <rect width="600" height="450" fill="#1b241c"/>
  <g filter="url(#shadow)" transform="translate(150, 40)">
    <path d="M150,20 C240,60 280,180 260,280 C240,360 180,390 150,400 C120,390 60,360 40,280 C20,180 60,60 150,20 Z" fill="url(#leafGrad)" stroke="#1a4217" stroke-width="3"/>
    <path d="M150,30 L150,395" stroke="#68a35f" stroke-width="4" stroke-linecap="round"/>
    <path d="M150,100 Q190,80 230,90 M150,160 Q200,140 245,170 M150,230 Q200,210 240,260 M150,300 Q190,290 220,330" stroke="#57914f" stroke-width="2.5" fill="none"/>
    <path d="M150,100 Q110,80 70,90 M150,160 Q100,140 55,170 M150,230 Q100,210 60,260 M150,300 Q110,290 80,330" stroke="#57914f" stroke-width="2.5" fill="none"/>
    <ellipse cx="200" cy="180" rx="45" ry="32" fill="url(#blightLesion)"/>
    <ellipse cx="105" cy="240" rx="38" ry="28" fill="url(#blightLesion)"/>
    <ellipse cx="170" cy="290" rx="42" ry="25" fill="url(#blightLesion)"/>
    <path d="M180,165 Q195,155 210,160 M90,225 Q105,215 120,220" stroke="#e0e8dc" stroke-width="2.5" stroke-dasharray="2,3" fill="none"/>
  </g>
  <rect x="20" y="390" width="560" height="42" rx="8" fill="#0f1712" fill-opacity="0.85"/>
  <text x="300" y="416" fill="#4ade80" font-family="sans-serif" font-size="15" font-weight="bold" text-anchor="middle">BENCHMARK SPECIMEN: Solanum lycopersicum (Tomato Late Blight - Phytophthora infestans)</text>
</svg>
