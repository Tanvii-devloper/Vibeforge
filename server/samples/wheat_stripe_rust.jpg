<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 450" width="100%" height="100%">
  <defs>
    <linearGradient id="wheatBlade" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#2d6e24"/>
      <stop offset="50%" stop-color="#4d9b3d"/>
      <stop offset="100%" stop-color="#225c1a"/>
    </linearGradient>
  </defs>
  <rect width="600" height="450" fill="#1b241c"/>
  <g transform="translate(180, 20)">
    <!-- Wheat Blade Shape -->
    <path d="M70,10 C150,10 170,100 170,410 L70,410 C70,100 90,10 70,10 Z" fill="url(#wheatBlade)" stroke="#1a4217" stroke-width="2.5"/>
    <line x1="120" y1="10" x2="120" y2="410" stroke="#75bd65" stroke-width="3"/>
    <!-- Linear Orange Stripe Rust Pustules -->
    <g fill="#f97316" stroke="#c2410c" stroke-width="0.8">
      <!-- Stripe 1 -->
      <ellipse cx="100" cy="80" rx="3" ry="8"/>
      <ellipse cx="100" cy="105" rx="3" ry="10"/>
      <ellipse cx="100" cy="135" rx="3" ry="9"/>
      <ellipse cx="100" cy="165" rx="3" ry="11"/>
      <ellipse cx="100" cy="200" rx="3" ry="10"/>
      <ellipse cx="100" cy="235" rx="3" ry="8"/>
      <ellipse cx="100" cy="270" rx="3" ry="10"/>
      <ellipse cx="100" cy="305" rx="3" ry="12"/>
      <!-- Stripe 2 -->
      <ellipse cx="140" cy="110" rx="3" ry="9"/>
      <ellipse cx="140" cy="140" rx="3" ry="12"/>
      <ellipse cx="140" cy="175" rx="3" ry="10"/>
      <ellipse cx="140" cy="215" rx="3" ry="14"/>
      <ellipse cx="140" cy="250" rx="3" ry="9"/>
      <ellipse cx="140" cy="290" rx="3" ry="11"/>
      <ellipse cx="140" cy="330" rx="3" ry="8"/>
    </g>
  </g>
  <rect x="20" y="390" width="560" height="42" rx="8" fill="#0f1712" fill-opacity="0.85"/>
  <text x="300" y="416" fill="#fb923c" font-family="sans-serif" font-size="15" font-weight="bold" text-anchor="middle">BENCHMARK SPECIMEN: Triticum aestivum (Wheat Stripe Rust - Puccinia striiformis)</text>
</svg>
